{
  "*": [
    { "when": { "shape": "curved", "touch": "index" }, "label": "O" },
    { "when": { "shape": "curved", "thumbPos": ["side", "out"] }, "label": "C" },
    { "when": { "hookIndex": true }, "label": "X" }
  ],

  "[1, 1, 1, 1, 1]": "Hello / Paper / 5",

  "[0, 0, 0, 0, 0]": "Rock / Fist / S",

  "[1, 0, 0, 0, 0]": [
    { "when": { "thumbPos": "out", "thumbDir": "up" }, "label": "Thumbs Up / Good" },
    { "when": { "thumbPos": "out", "thumbDir": "down" }, "label": "Thumbs Down / Bad" },
    { "when": { "thumbPos": "side" }, "label": "A" }
  ],

  "[0, 1, 0, 0, 0]": [
    { "when": { "touch": "middle" }, "label": "D" },
    "Number 1"
  ],

  "[1, 1, 0, 0, 0]": [
    { "when": { "touch": "middle" }, "label": "D" },
    { "when": { "indexDir": "up", "thumbDir": "side" }, "label": "L" },
    { "when": { "indexDir": "side" }, "label": "G" },
    { "when": { "indexDir": "up" }, "label": "Number 1" }
  ],

  "[0, 1, 1, 0, 0]": [
    { "when": { "spread": "together", "indexDir": "side" }, "label": "H" },
    { "when": { "spread": "together" }, "label": "U" },
    "Peace / V / 2"
  ],

  "[1, 1, 1, 0, 0]": [
    { "when": { "spread": "apart", "thumbDir": "up" }, "label": "K" },
    "Number 3"
  ],

  "[0, 1, 1, 1, 0]": "W",

  "[0, 1, 1, 1, 1]": [
    { "when": { "spread": "apart" }, "label": "Number 4" },
    "B"
  ],

  "[0, 0, 1, 1, 1]": [
    { "when": { "touch": "index" }, "label": "F / OK" }
  ],

  "[0, 0, 0, 0, 1]": "I",

  "[1, 0, 0, 0, 1]": "Hang Loose / Y",

  "[1, 1, 0, 0, 1]": "I Love You"
}